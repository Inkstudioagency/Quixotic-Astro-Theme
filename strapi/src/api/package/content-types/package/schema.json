{
  "kind": "collectionType",
  "collectionName": "packages",
  "info": {
    "singularName": "package",
    "pluralName": "packages",
    "displayName": "Package",
    "description": "Travel CMS: tour packages rendered on /packages, /package/[slug], destination pages and the home page tabs."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "metaDescription": {
      "type": "text"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "location": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "price": {
      "type": "string"
    },
    "rating": {
      "type": "string"
    },
    "reviewCount": {
      "type": "string"
    },
    "overview": {
      "type": "blocks"
    },
    "inclusions": {
      "type": "component",
      "repeatable": false,
      "component": "travel.inclusions"
    },
    "itinerary": {
      "type": "component",
      "repeatable": true,
      "component": "travel.itinerary-day"
    },
    "additionalInfo": {
      "type": "text"
    },
    "tripType": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "homeTabs": {
      "type": "component",
      "repeatable": false,
      "component": "travel.home-tabs"
    },
    "destinations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::destination.destination",
      "mappedBy": "packages"
    }
  }
}
