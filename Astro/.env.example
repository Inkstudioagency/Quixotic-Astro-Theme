# Public URL of the deployed site (canonical links, absolute social-share image URLs).
SITE_URL=https://www.example.com

# Strapi CMS. Leave STRAPI_URL empty to use the bundled demo content (src/data/cms.json).
STRAPI_URL=http://localhost:1337
# Optional read-only API token (Strapi admin > Settings > API Tokens). Not needed when the
# Public role can read the collections (the bundled seed sets this up).
STRAPI_TOKEN=
# true: fail the build if Strapi is unreachable instead of falling back to bundled content.
STRAPI_REQUIRED=false

# Form submissions (Formspree, Getform, Basin, your own function…). Empty: forms show the
# success message without sending anything (demo mode).
PUBLIC_FORM_ENDPOINT=
