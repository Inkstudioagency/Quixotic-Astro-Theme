---
// Blog post: "related posts" (the two newest other posts).
import BlogCard from "../cms/BlogCard.astro";
import type { Blog } from "../../lib/cms";

interface Props {
  posts: Blog[];
}

const { posts } = Astro.props;
---
<section class="section_blog">
  <div class="section-gap">
    <div class="container-main">
      <div class="blog-wrapper">
        <div class="blog-top">
          <div class="blog-heading-block">
            <div class="section-eyebrow">
              <div class="section-eyebrow-icon w-embed"><svg aria-hidden="true" width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M15.97 8c0 1.05-.67 1.51-.87 1.63-.57.32-1.28.3-1.77.27a8.4 8.4 0 0 1-1.21-.19c.34.22.67.46.98.72.38.32.9.81 1.06 1.44.04.16.07.44 0 .76-.07.39-.26.73-.53 1.01-.74.74-1.55.6-1.77.53-.63-.17-1.120-.69-1.44-1.06a7.6 7.6 0 0 1-.72-.98c.09.4.15.8.18 1.21.04.49.06 1.2-.26 1.77-.08.14-.27.36-.54.54-.33.22-.71.33-1.1.33-1.04 0-1.51-.67-1.63-.87-.32-.57-.31-1.28-.26-1.77.03-.41.09-.81.18-1.21-.22.34-.46.67-.72.98-.32.38-.81.9-1.44 1.06-.16.04-.44.07-.76 0a1.98 1.98 0 0 1-1.01-.53c-.74-.74-.6-1.550-.53-1.77.17-.63.68-1.12 1.06-1.44.31-.26.64-.5.98-.72-.4.09-.8.15-1.21.18-.49.04-1.2.06-1.77-.26-.14-.08-.36-.27-.54-.54A1.98 1.98 0 0 1 0 8c0-1.05.67-1.51.88-1.63.56-.33 1.28-.31 1.77-.27.4.03.81.1 1.21.19-.34-.22-.67-.46-.99-.73-.37-.31-.89-.81-1.06-1.43a1.65 1.65 0 0 1-.01-.76c.08-.39.26-.74.54-1.01.74-.74 1.55-.6 1.77-.53.63.17 1.12.69 1.44 1.06.26.31.5.64.72.99-.09-.4-.15-.8-.18-1.21-.04-.49-.06-1.21.26-1.77.08-.14.27-.36.54-.54.33-.22.7-.33 1.1-.33 1.04 0 1.51.67 1.63.87.32.57.31 1.28.26 1.77-.03.41-.09.81-.18 1.21.22-.35.46-.68.72-.99.32-.37.81-.89 1.44-1.06.16-.04.44-.07.76 0 .39.08.74.26 1.01.54.74.74.6 1.55.53 1.77-.17.63-.68 1.12-1.06 1.44-.31.26-.64.5-.98.72.4-.09.8-.15 1.21-.19.49-.04 1.2-.06 1.77.27.14.08.36.27.54.54.22.33.33.71.33 1.1ZM10.28 8a2.3 2.3 0 1 0-4.6 0 2.3 2.3 0 0 0 4.6 0Z" fill="currentColor"></path>
                </svg></div>
              <div class="section-eyebrow-text">Blogs</div>
              <div class="section-eyebrow-icon w-embed"><svg aria-hidden="true" width="100%" height="100%" viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M15.97 8c0 1.05-.67 1.51-.87 1.63-.57.32-1.28.3-1.77.27a8.4 8.4 0 0 1-1.21-.19c.34.22.67.46.98.72.38.32.9.81 1.06 1.44.04.16.07.44 0 .76-.07.39-.26.73-.53 1.01-.74.74-1.55.6-1.77.53-.63-.17-1.120-.69-1.44-1.06a7.6 7.6 0 0 1-.72-.98c.09.4.15.8.18 1.21.04.49.06 1.2-.26 1.77-.08.14-.27.36-.54.54-.33.22-.71.33-1.1.33-1.04 0-1.51-.67-1.63-.87-.32-.57-.31-1.28-.26-1.77.03-.41.09-.81.18-1.21-.22.34-.46.67-.72.98-.32.38-.81.9-1.44 1.06-.16.04-.44.07-.76 0a1.98 1.98 0 0 1-1.01-.53c-.74-.74-.6-1.550-.53-1.77.17-.63.68-1.12 1.06-1.44.31-.26.64-.5.98-.72-.4.09-.8.15-1.21.18-.49.04-1.2.06-1.77-.26-.14-.08-.36-.27-.54-.54A1.98 1.98 0 0 1 0 8c0-1.05.67-1.51.88-1.63.56-.33 1.28-.31 1.77-.27.4.03.81.1 1.21.19-.34-.22-.67-.46-.99-.73-.37-.31-.89-.81-1.06-1.43a1.65 1.65 0 0 1-.01-.76c.08-.39.26-.74.54-1.01.74-.74 1.55-.6 1.77-.53.63.17 1.12.69 1.44 1.06.26.31.5.64.72.99-.09-.4-.15-.8-.18-1.21-.04-.49-.06-1.21.26-1.77.08-.14.27-.36.54-.54.33-.22.7-.33 1.1-.33 1.04 0 1.51.67 1.63.87.32.57.31 1.28.26 1.77-.03.41-.09.81-.18 1.21.22-.35.46-.68.72-.99.32-.37.81-.89 1.44-1.06.16-.04.44-.07.76 0 .39.08.74.26 1.01.54.74.74.6 1.55.53 1.77-.17.63-.68 1.12-1.06 1.44-.31.26-.64.5-.98.72.4-.09.8-.15 1.21-.19.49-.04 1.2-.06 1.77.27.14.08.36.27.54.54.22.33.33.71.33 1.1ZM10.28 8a2.3 2.3 0 1 0-4.6 0 2.3 2.3 0 0 0 4.6 0Z" fill="currentColor"></path>
                </svg></div>
            </div>
            <h2 class="heading-style-2">Related Articles</h2>
          </div>
          <div class="blog-button-block">
            <a data-wf-target="[[[&quot;12683dd5-0676-1864-7668-8aabbf7cf8ae&quot;,&quot;12683dd5-0676-1864-7668-8aabbf7cf8ae&quot;],[&quot;d396867b-eee1-9181-c2c7-5041458fd5f0&quot;]]]" data-wf--secondary-button--variant="base" data-wf-component-id="12683dd5-0676-1864-7668-8aabbf7cf8ae" data-wf-variant-state="base" href="/blog" class="secondary-button w-inline-block">
              <div class="button-text-mask">
                <div data-wf-target="[[[&quot;12683dd5-0676-1864-7668-8aabbf7cf8ae&quot;,&quot;12683dd5-0676-1864-7668-8aabbf7cf8b0&quot;],[&quot;d396867b-eee1-9181-c2c7-5041458fd5f0&quot;]]]" class="button-text">View all blogs</div>
                <div aria-hidden="true" data-wf-target="[[[&quot;12683dd5-0676-1864-7668-8aabbf7cf8ae&quot;,&quot;12683dd5-0676-1864-7668-8aabbf7cf8b1&quot;],[&quot;d396867b-eee1-9181-c2c7-5041458fd5f0&quot;]]]" class="button-text is-hover">View all blogs</div>
              </div>
            </a>
          </div>
        </div>
        <div class="w-dyn-list">
          {posts.length > 0 ? (
          <div role="list" class="blog-list is-two w-dyn-items">
            {posts.map((item) => (
            <BlogCard post={item} wide />
            ))}
          </div>
          ) : (
          <div class="w-dyn-empty">
            <div>No items found.</div>
          </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
