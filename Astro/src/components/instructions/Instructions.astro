dd" d="M15.97 8c0 1.05-.67 1.51-.87 1.63-.57.32-1.28.3-1.77.27a8.4 8.4 0 0 1-1.21-.19c.34.22.67.46.98.72.38.32.9.81 1.060 1.44.04.16.07.44 0 .76-.07.39-.26.73-.53 1.01-.74.74-1.55.6-1.77.53-.63-.17-1.120-.69-1.44-1.06a7.6 7.6 0 0 1-.72-.98c.09.4.15.8.18 1.21.04.49.06 1.2-.26 1.77-.08.14-.27.36-.54.54-.33.22-.71.33-1.1.33-1.04 0-1.51-.67-1.63-.87-.32-.57-.31-1.28-.26-1.77.03-.41.09-.81.18-1.21-.22.34-.46.67-.72.98-.32.38-.81.9-1.44 1.06-.16.04-.44.07-.76 0a1.98 1.98 0 0 1-1.01-.53c-.74-.74-.6-1.550-.53-1.77.17-.63.68-1.12 1.06-1.44.31-.26.64-.5.98-.72-.4.09-.8.15-1.21.18-.49.04-1.2.06-1.77-.26-.14-.08-.36-.27-.54-.54A1.98 1.98 0 0 1 0 8c0-1.05.67-1.51.88-1.63.56-.33 1.28-.31 1.77-.27.4.03.81.1 1.21.19-.34-.22-.67-.46-.99-.73-.37-.31-.89-.81-1.06-1.43a1.65 1.65 0 0 1-.01-.76c.08-.39.26-.74.54-1.01.74-.74 1.55-.6 1.77-.53.63.17 1.12.69 1.44 1.06.26.31.5.64.72.99-.09-.4-.15-.8-.18-1.21-.04-.49-.06-1.21.26-1.77.08-.14.27-.36.54-.54.33-.22.7-.33 1.1-.33 1.04 0 1.51.67 1.63.87.32.57.31 1.28.26 1.77-.03.41-.09.81-.18 1.21.22-.35.46-.68.72-.99.32-.37.81-.89 1.44-1.06.16-.04.44-.07.76 0 .39.08.74.26 1.01.54.74.74.6 1.55.53 1.77-.17.63-.68 1.12-1.06 1.44-.31.26-.64.5-.98.72.4-.09.8-.15 1.21-.19.49-.04 1.2-.06 1.77.27.14.08.36.27.54.54.22.33.33.71.33 1.1ZM10.28 8a2.3 2.3 0 1 0-4.6 0 2.3 2.3 0 0 0 4.6 0Z" fill="currentColor"/></svg></div></div><h1 hero-title="" class="heading-style-1 is-white">How To Customise Quixotic</h1><p page-load-3="" class="text-size-large text-color-white is-hero-text">A short guide to the content, Strapi CMS, components, styles, forms and animations in this theme, so you can make it yours with confidence.</p></div></div></section>
<section class="section_instructions"><div class="w-layout-blockcontainer container-main w-container"><div page-load-4="" class="instructions-layout"><nav class="instructions-nav">{sections.map((s) => <a href={`#${s.id}`} class="instructions-nav-link">{s.nav}</a>)}</nav><div class="instructions-content">
  {sections.map((s, i) => (
    <div id={s.id} class={i === sections.length - 1 ? "instructions-block is-last" : "instructions-block"}>
      <h2 class="heading-style-4">{s.title}</h2>
      {s.blocks.map((b) =>
        b.type === "p" ? <p class="text-size-regular" set:html={b.html} />
        : b.type === "h3" ? <h3 class="heading-style-5">{b.text}</h3>
        : b.type === "callout" ? <div class="instructions-callout" set:html={b.html} />
        : b.type === "code" ? <div class="instructions-code-entry"><h3 class="heading-style-5">{b.title}</h3><p class="text-size-regular" set:html={b.html} /><p data-lenis-prevent="" class="instructions-code">{b.code}</p></div>
        : b.type === "ol" ? <ol role="list" class="utility-list">{b.items.map((li) => <li class="utility-list-item" set:html={li} />)}</ol>
        : <ul role="list" class="utility-list">{b.items.map((li) => <li class="utility-list-item" set:html={li} />)}</ul>
      )}
    </div>
  ))}
</div></div></div></section>
