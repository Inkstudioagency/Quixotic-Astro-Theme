---
// Package page body: overview, inclusions, itinerary, extra info and booking card.
import RichText from "../cms/RichText.astro";
import { WF_PAGE_IDS } from "../../config/site";
import type { Package } from "../../lib/cms";

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;
---
<section class="section_package-details">
  <div class="container-main">
    <div class="package-details-layout">
      <div class="package-details-main">
        <div class="package-detail-block">
          <h2 class="package-detail-title">Tour details</h2>
          <RichText blocks={pkg.overview} class="package-rich-text w-richtext" />
        </div>
        <div class="package-detail-block">
          <h2 class="package-detail-title">What’s Included</h2>
          <div class="package-amenities">
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M1.66667 15.4167V4.58333M1.66667 12.0833H18.3333M18.3333 12.0833V15.4167M18.3333 12.0833V8.75H1.66667M5 8.75C5 7.08333 5.83333 6.25 7.5 6.25H9.16667V8.75" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.stay}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 15.2083C4.16667 13.5417 5.83333 13.5417 7.5 15.2083C9.16667 16.875 10.8333 16.875 12.5 15.2083C14.1667 13.5417 15.8333 13.5417 17.5 15.2083M6.66667 12.7083V5.20833C6.66667 3.95833 7.5 3.54167 8.33333 3.54167M13.3333 12.7083V5.20833C13.3333 3.95833 14.1667 3.54167 15 3.54167M6.66667 6.875H13.3333M6.66667 9.79167H13.3333" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.wellness}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M11.6667 5.83333V14.1667M2.5 5.83333H17.5V8.33333C16.25 8.33333 15.8333 9.16667 15.8333 10C15.8333 10.8333 16.25 11.6667 17.5 11.6667V14.1667H2.5V11.6667C3.75 11.6667 4.16667 10.8333 4.16667 10C4.16667 9.16667 3.75 8.33333 2.5 8.33333V5.83333Z" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.entryFees}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M4.58333 17.5V2.5M4.58333 3.33333H15.4167L12.9167 6.66667L15.4167 10H4.58333" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.guide}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M7.08333 2.5V17.5M4.58333 2.5V6.66667C4.58333 8.33333 9.58333 8.33333 9.58333 6.66667V2.5M15.4167 17.5V2.5C12.9167 4.16667 12.9167 9.16667 15.4167 10.8333" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.meals}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M10 8.75C13.3333 8.75 14.1667 5.41667 13.3333 2.08333H6.66667C5.83334 5.41667 6.66667 8.75 10 8.75ZM10 8.75V17.0833M6.66667 17.9167H13.3333" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.tasting}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M8.3865 9.79167L6.71984 5.20833L8.3865 4.79167L12.1365 8.54167M1.71984 15.2083L17.5532 8.54167C18.8032 7.95833 18.3865 6.45833 16.7198 6.875L5.05317 11.0417L2.96984 8.95833L1.71984 9.79167V15.2083Z" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.transfers}</div>
            </div>
            <div class="package-amenity">
              <div class="package-amenity-icon">
                <div class="package-amenity-svg w-embed"><svg width="100%" height="100%" viewbox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M10 2.5V14.1667M10 3.33333L15.8333 11.6667H10M1.66667 14.1667H18.3333L15.8333 17.5H4.16667L1.66667 14.1667Z" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"></path>
                  </svg></div>
              </div>
              <div class="package-amenity-text">{pkg.inclusions.boatTrip}</div>
            </div>
          </div>
        </div>
        <div class="package-detail-block is-plan">
          <h2 class="package-detail-title is-bordered">Day-By-Day Plan</h2>
          {pkg.itinerary.map((day, i) => (
          <div class="package-day">
            <div class="package-day-pill">Day {String(i + 1).padStart(2, "0")}</div>
            <div class="package-day-content">
              <h3 class="package-day-title">{day.title}</h3>
              <p class="package-day-text">{day.details}</p>
            </div>
          </div>
          ))}
        </div>
        <div class="package-detail-block">
          <h2 class="package-detail-title">Why Travelers Love It</h2>
          <div class="package-why-grid">
            <div class="package-why-card">
              <div class="package-why-icon w-embed"><svg aria-hidden="true" width="100%" height="100%" viewbox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="16" cy="10" r="5" stroke="currentColor" stroke-width="1.8"></circle>
                  <path d="M6 27c0-5.5 4.5-9 10-9s10 3.5 10 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                  <path d="M21 4.5l1.2 2.4 2.6.4-1.9 1.8.5 2.6L21 10.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
                </svg></div>
              <div class="package-why-text-block">
                <h3 class="package-why-title">Local Experts</h3>
                <p class="package-why-text">Every tour is led by certified local guides who share the stories behind each place.</p>
              </div>
            </div>
            <div class="package-why-card">
              <div class="package-why-icon w-embed"><svg aria-hidden="true" width="100%" height="100%" viewbox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 8l7-3 10 3 7-3v19l-7 3-10-3-7 3V8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                  <path d="M11 5v19M21 8v19" stroke="currentColor" stroke-width="1.8"></path>
                </svg></div>
              <div class="package-why-text-block">
                <h3 class="package-why-title">Flexible Timings</h3>
                <p class="package-why-text">Pick morning or afternoon departures, with free time built into every day.</p>
              </div>
            </div>
            <div class="package-why-card">
              <div class="package-why-icon w-embed"><svg aria-hidden="true" width="100%" height="100%" viewbox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="22" cy="9" r="3.5" stroke="currentColor" stroke-width="1.8"></circle>
                  <path d="M3 26l8-11 6 7 4-5 8 9H3Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                </svg></div>
              <div class="package-why-text-block">
                <h3 class="package-why-title">Scenic Spots</h3>
                <p class="package-why-text">Reach iconic viewpoints and quiet corners most visitors never find.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="package-detail-block">
          <h2 class="package-detail-title">Additional Info</h2>
          <p class="package-detail-text">{pkg.additionalInfo}</p>
        </div>
      </div>
      <aside class="package-booking-card">
        <div class="package-price">
          <div class="package-price-label">From</div>
          <div class="package-price-row">
            <div class="package-price-value">{pkg.price}</div>
            <div class="package-price-label">/ person</div>
          </div>
        </div>
        <div class="package-booking-divider"></div>
        <div class="package-booking-form-block w-form">
          <form id="wf-form-Package-Booking-Form" name="wf-form-Package-Booking-Form" data-name="Package Booking Form" method="get" class="package-booking-form" data-wf-page-id={WF_PAGE_IDS.package} data-wf-element-id="b2046fb7-eaac-31b4-c493-e1845e9f441c">
            <div class="package-booking-fields">
              <div class="package-booking-field is-name"><label for="name" class="package-booking-label">Full name</label><input class="package-booking-input w-input" maxlength="256" name="name" data-name="Name" placeholder="Your name" type="text" id="name" required=""></div>
              <div class="package-booking-field is-email"><label for="email" class="package-booking-label">Email address</label><input class="package-booking-input w-input" maxlength="256" name="email" data-name="Email" placeholder="you@example.com" type="email" id="email" required=""></div>
              <div class="package-booking-field"><label for="Guests" class="package-booking-label">Number of guests</label><select id="Guests" name="Guests" data-name="Guests" required="" class="package-booking-input w-select">
                  <option value="">Select guests</option>
                  <option value="1 guest">1 guest</option>
                  <option value="2 guests">2 guests</option>
                  <option value="3 guests">3 guests</option>
                  <option value="4 guests">4 guests</option>
                  <option value="5+ guests">5+ guests</option>
                </select></div>
              <div class="package-booking-row">
                <div class="package-booking-field"><label for="" class="package-booking-label">Check-in</label><input class="package-booking-input w-input" maxlength="256" name="Check-in" data-name="Check-in" placeholder="Example text" type="date" id="booking-check-in" required=""></div>
                <div class="package-booking-field"><label for="" class="package-booking-label">Check-out</label><input class="package-booking-input w-input" maxlength="256" name="Check-out" data-name="Check-out" placeholder="Example text" type="date" id="booking-check-out" required=""></div>
              </div>
              <div class="package-booking-field"><label for="" class="package-booking-label">Special notes</label><textarea placeholder="Dietary needs, celebrations, accessibility..." maxlength="5000" id="booking-notes" name="Notes" data-name="Notes" class="package-booking-input is-textarea w-input"></textarea></div>
            </div><input type="submit" data-wait="Sending..." class="package-booking-submit w-button" value="Book This Trip">
          </form>
          <div class="package-booking-success w-form-done">
            <div>Thank you! Your trip request is in. A planner will reply within 24 hours to confirm dates and availability.</div>
          </div>
          <div class="package-booking-error w-form-fail">
            <div>Something went wrong. Please check the fields and try again, or email hello@example.com.</div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
