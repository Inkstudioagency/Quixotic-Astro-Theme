---
// Package page image slider. Slide order matches the original template:
// gallery image 1, the thumbnail, then the remaining gallery images.
import Img from "../cms/Img.astro";
import type { Package } from "../../lib/cms";

interface Props {
  pkg: Package;
}

const { pkg } = Astro.props;
const [first, ...rest] = pkg.gallery;
const slides = [first, pkg.thumbnail, ...rest].filter(Boolean);
---
<section class="section_package-gallery">
  <div data-delay="4000" data-animation="slide" class="package-gallery-slider w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
    <div class="package-gallery-mask w-slider-mask">
      {slides.map((media) => (
      <div class="package-gallery-slide w-slide"><Img media={media} loading="lazy" width="976" height="960" class="package-gallery-image" /></div>
      ))}
    </div>
    <div class="package-gallery-arrow w-slider-arrow-left">
      <div class="package-gallery-arrow-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M11.25 4.5L6.75 9l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg></div>
    </div>
    <div class="package-gallery-arrow is-next w-slider-arrow-right">
      <div class="package-gallery-arrow-icon w-embed"><svg width="100%" height="100%" viewbox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6.75 4.5L11.25 9l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg></div>
    </div>
    <div class="package-gallery-nav w-slider-nav w-round w-num"></div>
  </div>
</section>
