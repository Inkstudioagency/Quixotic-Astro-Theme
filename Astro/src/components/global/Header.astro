---
// Site header + mega menu (shared by every page).
// Current-page link state is computed at build time.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/$/, "") || "/") === path;
const current = (href: string) => (isCurrent(href) ? "page" : undefined);
const linkClass = (cls: string, href: string) => (isCurrent(href) ? `${cls} w--current` : cls);
---
<header data-wf-component-id="0f8a6ee9-c25d-d746-89e7-c78a4a93731f" data-wf-variant-state="base" class="section_header">
  <nav aria-label="Main navigation" class="nav-wrapper">
    <div class="nav-bar"><button aria-label="Menu" type="button" popovertargetaction="toggle" popovertarget="w-popover-450684d4-0fb4-95d1-ecff-c5d96fdac021__b0297673-4aa6-6c0f-5831-82b45c1fcf94" class="nav-menu-button w-inline-block w-popover-trigger">
        <div class="nav-menu-line"></div>
        <div class="nav-menu-line"></div>
      </button>
      <a aria-label="Quixotic home" href="/" aria-current={current("/")} class={linkClass("brand-logo-block w-inline-block", "/")}><img src="/images/quixotic-logo.svg" loading="lazy" width="92" height="30" alt="Quixotic logo" class="brand-logo"></a>
      <div class="nav-button-block">
        <a data-wf-target="[[[&quot;6ecb507f-d06f-1563-fe11-5255e3c667ca&quot;,&quot;6ecb507f-d06f-1563-fe11-5255e3c667ca&quot;],[&quot;450684d4-0fb4-95d1-ecff-c5d96fdac021&quot;,&quot;0f8a6ee9-c25d-d746-89e7-c78a4a937328&quot;]]]" data-wf-component-id="6ecb507f-d06f-1563-fe11-5255e3c667ca" data-wf-variant-state="base" href="/contact" aria-current={current("/contact")} class={linkClass("primary-button w-inline-block", "/contact")}>
          <div class="button-text-mask">
            <div data-wf-target="[[[&quot;6ecb507f-d06f-1563-fe11-5255e3c667ca&quot;,&quot;6ecb507f-d06f-1563-fe11-5255e3c667cc&quot;],[&quot;450684d4-0fb4-95d1-ecff-c5d96fdac021&quot;,&quot;0f8a6ee9-c25d-d746-89e7-c78a4a937328&quot;]]]" class="button-text">Get in touch</div>
            <div aria-hidden="true" data-wf-target="[[[&quot;6ecb507f-d06f-1563-fe11-5255e3c667ca&quot;,&quot;6ecb507f-d06f-1563-fe11-5255e3c667cd&quot;],[&quot;450684d4-0fb4-95d1-ecff-c5d96fdac021&quot;,&quot;0f8a6ee9-c25d-d746-89e7-c78a4a937328&quot;]]]" class="button-text is-hover">Get in touch</div>
          </div>
        </a>
      </div>
    </div>
  </nav>
  <div aria-label="Main menu" data-wf-target="[[[&quot;0f8a6ee9-c25d-d746-89e7-c78a4a93731f&quot;,&quot;b0297673-4aa6-6c0f-5831-82b45c1fcf94&quot;],[&quot;450684d4-0fb4-95d1-ecff-c5d96fdac021&quot;]]]" id="w-popover-450684d4-0fb4-95d1-ecff-c5d96fdac021__b0297673-4aa6-6c0f-5831-82b45c1fcf94" data-w-popover-mode="auto" popover="auto" class="nav-popover w-popover">
