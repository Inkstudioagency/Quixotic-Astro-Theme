---
/**
 * BaseLayout — the document shell shared by every page.
 *
 * Reproduces the original template's <head> and the exact script order at the end
 * of <body>: jQuery → interaction runtime (site.js) → GSAP (+SplitText,
 * ScrollTrigger) → Lenis → site scripts → page scripts. All vendor files are
 * self-hosted in /public/js/vendor so the theme has no third-party CDN dependency
 * apart from Google Fonts.
 */
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import Preloader from "../components/global/Preloader.astro";
import ixPreloadCss from "../styles/ix-preload.css?raw";
import { SITE, WF_PAGE_IDS, type WfPage } from "../config/site";

interface Props {
  /** Full document title. */
  title?: string;
  description?: string;
  /** Absolute URL or /public path of the social share image. */
  ogImage?: string;
  /** Which exported page's interactions this page uses (see config/site.ts). */
  wfPage: WfPage;
  /** Hide the page from search engines (404, style guide). */
  noindex?: boolean;
  /** Page-only animation scripts from /public/js/quixotic (without .js). */
  scripts?: string[];
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  wfPage,
  noindex = false,
  scripts = [],
} = Astro.props;

const wfPageId = WF_PAGE_IDS[wfPage];
// The home page uses a slightly different DOM shell in the original template
// (header outside .page-wrapper, preloader after the footer).
const isHome = wfPage === "home";

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImageUrl = site && ogImage.startsWith("/") ? new URL(ogImage, site).href : ogImage;

const siteScripts = ["lenis", "counters", "cta-expand", "hero-curtain"];
// Optional form backend (Formspree, Getform, …). See public/js/quixotic/forms.js.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || undefined;
---
<!doctype html>
<html data-form-endpoint={formEndpoint} lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta content={description} name="description" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={ogImageUrl} property="og:image" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImageUrl} name="twitter:image" />
    <meta property="og:type" content="website" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link href="/css/normalize.css" rel="stylesheet" type="text/css" />
    <link href="/css/base.css" rel="stylesheet" type="text/css" />
    <link href="/css/quixotic.css" rel="stylesheet" type="text/css" />
    <style is:inline set:html={ixPreloadCss}></style>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="/js/vendor/webfont-1.6.26.js" type="text/javascript"></script>
    <script is:inline type="text/javascript">WebFont.load({ google: { families: ["Instrument Serif:400","Plus Jakarta Sans:200,300,400,500,600,700,800"] } });</script>
    <script is:inline type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
  </head>
  <body>
    {
      isHome ? (
        <>
          <Header />
          <div class="page-wrapper">
            <main class="main-wrapper">
              <slot />
            </main>
          </div>
          <Footer wfPageId={wfPageId} />
          <Preloader />
        </>
      ) : (
        <div class="page-wrapper">
          <Header />
          <main class="main-wrapper">
            <slot />
          </main>
          <Footer wfPageId={wfPageId} />
        </div>
      )
    }
    <script is:inline src="/js/quixotic/forms.js"></script>
    <script is:inline src="/js/vendor/jquery-3.5.1.min.js" type="text/javascript"></script>
    <script is:inline src="/js/site.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/gsap.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/SplitText.min.js" type="text/javascript"></script>
    <script is:inline src="/js/vendor/ScrollTrigger.min.js" type="text/javascript"></script>
    <link rel="stylesheet" href="/css/lenis.css" />
    <script is:inline src="/js/vendor/lenis.min.js"></script>
    {siteScripts.map((name) => <script is:inline src={`/js/quixotic/${name}.js`}></script>)}
    {scripts.map((name) => <script is:inline src={`/js/quixotic/${name}.js`}></script>)}
    <script is:inline src="/js/quixotic/packages-slide-blur.js" type="text/javascript"></script>
    <script is:inline src="/js/quixotic/nav-scroll-hide.js" type="text/javascript"></script>
  </body>
</html>
